DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase PostgreSQL settings
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_HOST=aws-1-us-west-2.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_SSLMODE=require

REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=your-active-groq-model-id
AI_DEFAULT_POLICY=C5
AI_CONFIDENCE_THRESHOLD=0.85
AI_NEAR_MATCH_THRESHOLD=0.65
AI_MAX_QUESTIONS=3
AI_SESSION_TTL_SECONDS=900
AI_SAMPLE_AGREEMENT_K=0
AI_LOG_TURNS=False
AI_POLICY_MODEL_PATH=artifacts/clarification_policy.joblib

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
